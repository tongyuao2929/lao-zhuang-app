[
  { "t": "道可道，非常道；名可名，非常名。", "s": "《道德经》第一章", "k": "ddj", "n": 1 },
  { "t": "玄之又玄，众妙之门。", "s": "《道德经》第一章", "k": "ddj", "n": 1 },
  { "t": "有无相生，难易相成，长短相较，高下相倾。", "s": "《道德经》第二章", "k": "ddj", "n": 2 },
  { "t": "生而不有，为而不恃，功成而弗居。", "s": "《道德经》第二章", "k": "ddj", "n": 2 },
  { "t": "虚其心，实其腹，弱其志，强其骨。", "s": "《道德经》第三章", "k": "ddj", "n": 3 },
  { "t": "挫其锐，解其纷，和其光，同其尘。", "s": "《道德经》第四章", "k": "ddj", "n": 4 },
  { "t": "天地不仁，以万物为刍狗。", "s": "《道德经》第五章", "k": "ddj", "n": 5 },
  { "t": "多言数穷，不如守中。", "s": "《道德经》第五章", "k": "ddj", "n": 5 },
  { "t": "谷神不死，是谓玄牝。", "s": "《道德经》第六章", "k": "ddj", "n": 6 },
  { "t": "后其身而身先，外其身而身存。", "s": "《道德经》第七章", "k": "ddj", "n": 7 },
  { "t": "上善若水，水善利万物而不争。", "s": "《道德经》第八章", "k": "ddj", "n": 8 },
  { "t": "夫唯不争，故无尤。", "s": "《道德经》第八章", "k": "ddj", "n": 8 },
  { "t": "持而盈之，不如其已。", "s": "《道德经》第九章", "k": "ddj", "n": 9 },
  { "t": "功遂身退，天之道也。", "s": "《道德经》第九章", "k": "ddj", "n": 9 },
  { "t": "载营魄抱一，能无离乎？", "s": "《道德经》第十章", "k": "ddj", "n": 10 },
  { "t": "有之以为利，无之以为用。", "s": "《道德经》第十一章", "k": "ddj", "n": 11 },
  { "t": "五色令人目盲，五音令人耳聋。", "s": "《道德经》第十二章", "k": "ddj", "n": 12 },
  { "t": "宠辱若惊，贵大患若身。", "s": "《道德经》第十三章", "k": "ddj", "n": 13 },
  { "t": "视之不见名曰夷，听之不闻名曰希，搏之不得名曰微。", "s": "《道德经》第十四章", "k": "ddj", "n": 14 },
  { "t": "豫兮若冬涉川，犹兮若畏四邻。", "s": "《道德经》第十五章", "k": "ddj", "n": 15 },
  { "t": "致虚极，守静笃。", "s": "《道德经》第十六章", "k": "ddj", "n": 16 },
  { "t": "万物并作，吾以观复。", "s": "《道德经》第十六章", "k": "ddj", "n": 16 },
  { "t": "太上，下知有之。", "s": "《道德经》第十七章", "k": "ddj", "n": 17 },
  { "t": "功成事遂，百姓皆谓我自然。", "s": "《道德经》第十七章", "k": "ddj", "n": 17 },
  { "t": "大道废，有仁义；智慧出，有大伪。", "s": "《道德经》第十八章", "k": "ddj", "n": 18 },
  { "t": "见素抱朴，少私寡欲。", "s": "《道德经》第十九章", "k": "ddj", "n": 19 },
  { "t": "众人皆有余，而我独若遗。", "s": "《道德经》第二十章", "k": "ddj", "n": 20 },
  { "t": "孔德之容，惟道是从。", "s": "《道德经》第二十一章", "k": "ddj", "n": 21 },
  { "t": "曲则全，枉则直，洼则盈。", "s": "《道德经》第二十二章", "k": "ddj", "n": 22 },
  { "t": "希言自然。", "s": "《道德经》第二十三章", "k": "ddj", "n": 23 },
  { "t": "企者不立，跨者不行。", "s": "《道德经》第二十四章", "k": "ddj", "n": 24 },
  { "t": "有物混成，先天地生。", "s": "《道德经》第二十五章", "k": "ddj", "n": 25 },
  { "t": "人法地，地法天，天法道，道法自然。", "s": "《道德经》第二十五章", "k": "ddj", "n": 25 },
  { "t": "重为轻根，静为躁君。", "s": "《道德经》第二十六章", "k": "ddj", "n": 26 },
  { "t": "善行无辙迹，善言无瑕谪。", "s": "《道德经》第二十七章", "k": "ddj", "n": 27 },
  { "t": "知其雄，守其雌，为天下溪。", "s": "《道德经》第二十八章", "k": "ddj", "n": 28 },
  { "t": "将欲取天下而为之，吾见其不得已。", "s": "《道德经》第二十九章", "k": "ddj", "n": 29 },
  { "t": "物壮则老，是谓不道。", "s": "《道德经》第三十章", "k": "ddj", "n": 30 },
  { "t": "夫佳兵者，不祥之器。", "s": "《道德经》第三十一章", "k": "ddj", "n": 31 },
  { "t": "道常无名，朴虽小，天下莫能臣也。", "s": "《道德经》第三十二章", "k": "ddj", "n": 32 },
  { "t": "知人者智，自知者明。", "s": "《道德经》第三十三章", "k": "ddj", "n": 33 },
  { "t": "胜人者有力，自胜者强。", "s": "《道德经》第三十三章", "k": "ddj", "n": 33 },
  { "t": "大道泛兮，其可左右。", "s": "《道德经》第三十四章", "k": "ddj", "n": 34 },
  { "t": "执大象，天下往。", "s": "《道德经》第三十五章", "k": "ddj", "n": 35 },
  { "t": "将欲歙之，必固张之；将欲弱之，必固强之。", "s": "《道德经》第三十六章", "k": "ddj", "n": 36 },
  { "t": "道常无为而无不为。", "s": "《道德经》第三十七章", "k": "ddj", "n": 37 },
  { "t": "上德不德，是以有德。", "s": "《道德经》第三十八章", "k": "ddj", "n": 38 },
  { "t": "昔之得一者，天得一以清，地得一以宁。", "s": "《道德经》第三十九章", "k": "ddj", "n": 39 },
  { "t": "反者道之动，弱者道之用。", "s": "《道德经》第四十章", "k": "ddj", "n": 40 },
  { "t": "大方无隅，大器晚成，大音希声，大象无形。", "s": "《道德经》第四十一章", "k": "ddj", "n": 41 },
  { "t": "道生一，一生二，二生三，三生万物。", "s": "《道德经》第四十二章", "k": "ddj", "n": 42 },
  { "t": "天下之至柔，驰骋天下之至坚。", "s": "《道德经》第四十三章", "k": "ddj", "n": 43 },
  { "t": "知足不辱，知止不殆，可以长久。", "s": "《道德经》第四十四章", "k": "ddj", "n": 44 },
  { "t": "大成若缺，其用不弊；大盈若冲，其用不穷。", "s": "《道德经》第四十五章", "k": "ddj", "n": 45 },
  { "t": "祸莫大于不知足，咎莫大于欲得。", "s": "《道德经》第四十六章", "k": "ddj", "n": 46 },
  { "t": "不出户，知天下；不窥牖，见天道。", "s": "《道德经》第四十七章", "k": "ddj", "n": 47 },
  { "t": "为学日益，为道日损。", "s": "《道德经》第四十八章", "k": "ddj", "n": 48 },
  { "t": "圣人无常心，以百姓心为心。", "s": "《道德经》第四十九章", "k": "ddj", "n": 49 },
  { "t": "出生入死。生之徒十有三，死之徒十有三。", "s": "《道德经》第五十章", "k": "ddj", "n": 50 },
  { "t": "道生之，德畜之，物形之，势成之。", "s": "《道德经》第五十一章", "k": "ddj", "n": 51 },
  { "t": "塞其兑，闭其门，终身不勤。", "s": "《道德经》第五十二章", "k": "ddj", "n": 52 },
  { "t": "大道甚夷，而民好径。", "s": "《道德经》第五十三章", "k": "ddj", "n": 53 },
  { "t": "善建者不拔，善抱者不脱。", "s": "《道德经》第五十四章", "k": "ddj", "n": 54 },
  { "t": "含德之厚，比于赤子。", "s": "《道德经》第五十五章", "k": "ddj", "n": 55 },
  { "t": "知者不言，言者不知。", "s": "《道德经》第五十六章", "k": "ddj", "n": 56 },
  { "t": "以正治国，以奇用兵，以无事取天下。", "s": "《道德经》第五十七章", "k": "ddj", "n": 57 },
  { "t": "祸兮福之所倚，福兮祸之所伏。", "s": "《道德经》第五十八章", "k": "ddj", "n": 58 },
  { "t": "治人事天，莫若啬。", "s": "《道德经》第五十九章", "k": "ddj", "n": 59 },
  { "t": "治大国若烹小鲜。", "s": "《道德经》第六十章", "k": "ddj", "n": 60 },
  { "t": "大国者下流，天下之交，天下之牝。", "s": "《道德经》第六十一章", "k": "ddj", "n": 61 },
  { "t": "道者万物之奥。", "s": "《道德经》第六十二章", "k": "ddj", "n": 62 },
  { "t": "为无为，事无事，味无味。", "s": "《道德经》第六十三章", "k": "ddj", "n": 63 },
  { "t": "图难于其易，为大于其细。", "s": "《道德经》第六十三章", "k": "ddj", "n": 63 },
  { "t": "合抱之木，生于毫末；九层之台，起于累土。", "s": "《道德经》第六十四章", "k": "ddj", "n": 64 },
  { "t": "千里之行，始于足下。", "s": "《道德经》第六十四章", "k": "ddj", "n": 64 },
  { "t": "古之善为道者，非以明民，将以愚之。", "s": "《道德经》第六十五章", "k": "ddj", "n": 65 },
  { "t": "江海所以能为百谷王者，以其善下之。", "s": "《道德经》第六十六章", "k": "ddj", "n": 66 },
  { "t": "我有三宝，持而保之：一曰慈，二曰俭，三曰不敢为天下先。", "s": "《道德经》第六十七章", "k": "ddj", "n": 67 },
  { "t": "善为士者不武，善战者不怒。", "s": "《道德经》第六十八章", "k": "ddj", "n": 68 },
  { "t": "祸莫大于轻敌，轻敌几丧吾宝。", "s": "《道德经》第六十九章", "k": "ddj", "n": 69 },
  { "t": "吾言甚易知，甚易行；天下莫能知，莫能行。", "s": "《道德经》第七十章", "k": "ddj", "n": 70 },
  { "t": "知不知上，不知知病。", "s": "《道德经》第七十一章", "k": "ddj", "n": 71 },
  { "t": "勇于敢则杀，勇于不敢则活。", "s": "《道德经》第七十三章", "k": "ddj", "n": 73 },
  { "t": "民不畏死，奈何以死惧之？", "s": "《道德经》第七十四章", "k": "ddj", "n": 74 },
  { "t": "人之生也柔弱，其死也坚强。", "s": "《道德经》第七十六章", "k": "ddj", "n": 76 },
  { "t": "天之道，损有余而补不足。", "s": "《道德经》第七十七章", "k": "ddj", "n": 77 },
  { "t": "天下莫柔弱于水，而攻坚强者莫之能胜。", "s": "《道德经》第七十八章", "k": "ddj", "n": 78 },
  { "t": "天道无亲，常与善人。", "s": "《道德经》第七十九章", "k": "ddj", "n": 79 },
  { "t": "小国寡民。", "s": "《道德经》第八十章", "k": "ddj", "n": 80 },
  { "t": "信言不美，美言不信。", "s": "《道德经》第八十一章", "k": "ddj", "n": 81 },
  { "t": "北冥有鱼，其名为鲲。鲲之大，不知其几千里也。", "s": "《庄子·逍遥游》", "k": "zz", "g": "内篇", "i": 0 },
  { "t": "鹏之徙于南冥也，水击三千里。", "s": "《庄子·逍遥游》", "k": "zz", "g": "内篇", "i": 0 },
  { "t": "野马也，尘埃也，生物之以息相吹也。", "s": "《庄子·逍遥游》", "k": "zz", "g": "内篇", "i": 0 },
  { "t": "小知不及大知，小年不及大年。", "s": "《庄子·逍遥游》", "k": "zz", "g": "内篇", "i": 0 },
  { "t": "举世誉之而不加劝，举世非之而不加沮。", "s": "《庄子·逍遥游》", "k": "zz", "g": "内篇", "i": 0 },
  { "t": "至人无己，神人无功，圣人无名。", "s": "《庄子·逍遥游》", "k": "zz", "g": "内篇", "i": 0 },
  { "t": "夫列子御风而行，泠然善也。", "s": "《庄子·逍遥游》", "k": "zz", "g": "内篇", "i": 0 },
  { "t": "人皆知有用之用，而莫知无用之用也。", "s": "《庄子·人间世》", "k": "zz", "g": "内篇", "i": 3 },
  { "t": "今之隐几者，非昔之隐几者也。", "s": "《庄子·齐物论》", "k": "zz", "g": "内篇", "i": 1 },
  { "t": "大知闲闲，小知间间；大言炎炎，小言詹詹。", "s": "《庄子·齐物论》", "k": "zz", "g": "内篇", "i": 1 },
  { "t": "道恶乎隐而有真伪？言恶乎隐而有是非？", "s": "《庄子·齐物论》", "k": "zz", "g": "内篇", "i": 1 },
  { "t": "彼亦一是非，此亦一是非。", "s": "《庄子·齐物论》", "k": "zz", "g": "内篇", "i": 1 },
  { "t": "天地与我并生，而万物与我为一。", "s": "《庄子·齐物论》", "k": "zz", "g": "内篇", "i": 1 },
  { "t": "六合之外，圣人存而不论。", "s": "《庄子·齐物论》", "k": "zz", "g": "内篇", "i": 1 },
  { "t": "昔者庄周梦为蝴蝶，栩栩然蝴蝶也。", "s": "《庄子·齐物论》", "k": "zz", "g": "内篇", "i": 1 },
  { "t": "不知周之梦为蝴蝶与，蝴蝶之梦为周与？", "s": "《庄子·齐物论》", "k": "zz", "g": "内篇", "i": 1 },
  { "t": "吾生也有涯，而知也无涯。", "s": "《庄子·养生主》", "k": "zz", "g": "内篇", "i": 2 },
  { "t": "缘督以为经，可以保身，可以全生。", "s": "《庄子·养生主》", "k": "zz", "g": "内篇", "i": 2 },
  { "t": "臣之所好者道也，进乎技矣。", "s": "《庄子·养生主》", "k": "zz", "g": "内篇", "i": 2 },
  { "t": "以无厚入有间，恢恢乎其于游刃必有余地矣。", "s": "《庄子·养生主》", "k": "zz", "g": "内篇", "i": 2 },
  { "t": "为善无近名，为恶无近刑。", "s": "《庄子·养生主》", "k": "zz", "g": "内篇", "i": 2 },
  { "t": "安时而处顺，哀乐不能入也。", "s": "《庄子·养生主》", "k": "zz", "g": "内篇", "i": 2 },
  { "t": "夫哀莫大于心死，而人死亦次之。", "s": "《庄子·田子方》", "k": "zz", "g": "外篇", "i": 13 },
  { "t": "若一志，无听之以耳而听之以心。", "s": "《庄子·人间世》", "k": "zz", "g": "内篇", "i": 3 },
  { "t": "听止于耳，心止于符。", "s": "《庄子·人间世》", "k": "zz", "g": "内篇", "i": 3 },
  { "t": "唯道集虚。虚者，心斋也。", "s": "《庄子·人间世》", "k": "zz", "g": "内篇", "i": 3 },
  { "t": "人皆知有用之用，而莫知无用之用也。", "s": "《庄子·人间世》", "k": "zz", "g": "内篇", "i": 3 },
  { "t": "山木自寇也，膏火自煎也。", "s": "《庄子·人间世》", "k": "zz", "g": "内篇", "i": 3 },
  { "t": "德有所长而形有所忘。", "s": "《庄子·德充符》", "k": "zz", "g": "内篇", "i": 4 },
  { "t": "鉴明则尘垢不止，止则不明也。", "s": "《庄子·德充符》", "k": "zz", "g": "内篇", "i": 4 },
  { "t": "常因自然而不益生也。", "s": "《庄子·德充符》", "k": "zz", "g": "内篇", "i": 4 },
  { "t": "知天之所为，知人之所为者，至矣。", "s": "《庄子·大宗师》", "k": "zz", "g": "内篇", "i": 5 },
  { "t": "泉涸，鱼相与处于陆，相呴以湿，相濡以沫。", "s": "《庄子·大宗师》", "k": "zz", "g": "内篇", "i": 5 },
  { "t": "相濡以沫，不如相忘于江湖。", "s": "《庄子·大宗师》", "k": "zz", "g": "内篇", "i": 5 },
  { "t": "古之真人，不知说生，不知恶死。", "s": "《庄子·大宗师》", "k": "zz", "g": "内篇", "i": 5 },
  { "t": "鱼相忘乎江湖，人相忘乎道术。", "s": "《庄子·大宗师》", "k": "zz", "g": "内篇", "i": 5 },
  { "t": "堕肢体，黜聪明，离形去知，同于大通。", "s": "《庄子·大宗师》", "k": "zz", "g": "内篇", "i": 5 },
  { "t": "无为名尸，无为谋府，无为事任，无为知主。", "s": "《庄子·应帝王》", "k": "zz", "g": "内篇", "i": 6 },
  { "t": "至人之用心若镜，不将不迎，应而不藏。", "s": "《庄子·应帝王》", "k": "zz", "g": "内篇", "i": 6 },
  { "t": "日凿一窍，七日而浑沌死。", "s": "《庄子·应帝王》", "k": "zz", "g": "内篇", "i": 6 },
  { "t": "彼民有常性，织而衣，耕而食。", "s": "《庄子·马蹄》", "k": "zz", "g": "外篇", "i": 1 },
  { "t": "同乎无知，其德不离；同乎无欲，是谓素朴。", "s": "《庄子·马蹄》", "k": "zz", "g": "外篇", "i": 1 },
  { "t": "故绝圣弃知，大盗乃止。", "s": "《庄子·胠箧》", "k": "zz", "g": "外篇", "i": 2 },
  { "t": "彼窃钩者诛，窃国者为诸侯。", "s": "《庄子·胠箧》", "k": "zz", "g": "外篇", "i": 2 },
  { "t": "闻在宥天下，不闻治天下也。", "s": "《庄子·在宥》", "k": "zz", "g": "外篇", "i": 3 },
  { "t": "无视无听，抱神以静，形将自正。", "s": "《庄子·在宥》", "k": "zz", "g": "外篇", "i": 3 },
  { "t": "天地虽大，其化均也；万物虽多，其治一也。", "s": "《庄子·天地》", "k": "zz", "g": "外篇", "i": 4 },
  { "t": "至言不出，俗言胜也。", "s": "《庄子·天地》", "k": "zz", "g": "外篇", "i": 4 },
  { "t": "夫虚静恬淡寂漠无为者，天地之平而道德之至也。", "s": "《庄子·天道》", "k": "zz", "g": "外篇", "i": 5 },
  { "t": "水静则明烛须眉，平中准，大匠取法焉。", "s": "《庄子·天道》", "k": "zz", "g": "外篇", "i": 5 },
  { "t": "天道运而无所积，故万物成。", "s": "《庄子·天道》", "k": "zz", "g": "外篇", "i": 5 },
  { "t": "夫道，于大不终，于小不遗。", "s": "《庄子·天道》", "k": "zz", "g": "外篇", "i": 5 },
  { "t": "意之所随者，不可以言传也。", "s": "《庄子·天道》", "k": "zz", "g": "外篇", "i": 5 },
  { "t": "至乐无乐，至誉无誉。", "s": "《庄子·至乐》", "k": "zz", "g": "外篇", "i": 10 },
  { "t": "生也死之徒，死也生之始。", "s": "《庄子·知北游》", "k": "zz", "g": "外篇", "i": 14 },
  { "t": "天地有大美而不言，四时有明法而不议。", "s": "《庄子·知北游》", "k": "zz", "g": "外篇", "i": 14 },
  { "t": "圣人者，原天地之美而达万物之理。", "s": "《庄子·知北游》", "k": "zz", "g": "外篇", "i": 14 },
  { "t": "人生天地之间，若白驹之过郤，忽然而已。", "s": "《庄子·知北游》", "k": "zz", "g": "外篇", "i": 14 },
  { "t": "知北游于玄水之上，登隐弅之丘。", "s": "《庄子·知北游》", "k": "zz", "g": "外篇", "i": 14 },
  { "t": "庄子与惠子游于濠梁之上。", "s": "《庄子·秋水》", "k": "zz", "g": "外篇", "i": 9 },
  { "t": "子非鱼，安知鱼之乐？", "s": "《庄子·秋水》", "k": "zz", "g": "外篇", "i": 9 },
  { "t": "井蛙不可以语于海者，拘于虚也。", "s": "《庄子·秋水》", "k": "zz", "g": "外篇", "i": 9 },
  { "t": "夏虫不可以语于冰者，笃于时也。", "s": "《庄子·秋水》", "k": "zz", "g": "外篇", "i": 9 },
  { "t": "吾在天地之间，犹小石小木之在大山也。", "s": "《庄子·秋水》", "k": "zz", "g": "外篇", "i": 9 },
  { "t": "达生之情者，不务生之所无以为。", "s": "《庄子·达生》", "k": "zz", "g": "外篇", "i": 11 },
  { "t": "用志不分，乃凝于神。", "s": "《庄子·达生》", "k": "zz", "g": "外篇", "i": 11 },
  { "t": "忘足，履之适也；忘腰，带之适也。", "s": "《庄子·达生》", "k": "zz", "g": "外篇", "i": 11 },
  { "t": "山木自寇也，膏火自煎也。", "s": "《庄子·山木》", "k": "zz", "g": "外篇", "i": 12 },
  { "t": "君子之交淡若水，小人之交甘若醴。", "s": "《庄子·山木》", "k": "zz", "g": "外篇", "i": 12 },
  { "t": "知其不可奈何而安之若命，德之至也。", "s": "《庄子·人间世》", "k": "zz", "g": "内篇", "i": 3 },
  { "t": "言者所以在意，得意而忘言。", "s": "《庄子·外物》", "k": "zz", "g": "杂篇", "i": 3 },
  { "t": "筌者所以在鱼，得鱼而忘筌。", "s": "《庄子·外物》", "k": "zz", "g": "杂篇", "i": 3 },
  { "t": "蹄者所以在兔，得兔而忘蹄。", "s": "《庄子·外物》", "k": "zz", "g": "杂篇", "i": 3 },
  { "t": "寓言十九，重言十七，卮言日出，和以天倪。", "s": "《庄子·寓言》", "k": "zz", "g": "杂篇", "i": 4 },
  { "t": "独与天地精神往来，而不敖倪于万物。", "s": "《庄子·天下》", "k": "zz", "g": "杂篇", "i": 10 },
  { "t": "上与造物者游，而下与外死生无终始者为友。", "s": "《庄子·天下》", "k": "zz", "g": "杂篇", "i": 10 },
  { "t": "以本为精，以物为粗，以有积为不足。", "s": "《庄子·天下》", "k": "zz", "g": "杂篇", "i": 10 },
  { "t": "芒乎昧乎，未之尽者。", "s": "《庄子·天下》", "k": "zz", "g": "杂篇", "i": 10 }
]
